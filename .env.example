# copy to .env and adjust
DEVCON_PASSWORD=change-me

# host ports (defaults shown)
DEVCON_WEB_PORT=8443
DEVCON_SSH_PORT=2222

# host path for the /config volume (default: /.config)
DEVCON_CONFIG=/.config

# user/group that owns files in the volume (check on the host with `id -u` / `id -g`)
DEVCON_PUID=1000
DEVCON_PGID=100

# login username inside the container (default: abc)
DEVCON_USER=abc

# --- optional access services ---
# Set either to false to keep the container running without that listener.
DEVCON_CODE_SERVER=true
DEVCON_SSH=true

# git identity for the login user inside the container
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# --- ssh access ---
# Default is key-only. Provide a public key here to have it installed into
# authorized_keys automatically (otherwise append one yourself in the volume).
DEVCON_SSH_PUBKEY=

# Set to true to allow ssh password login. When on, DEVCON_SSH_PASSWORD is
# required and becomes the login user's password. Leave off for key-only.
DEVCON_SSH_PASSWORD_AUTH=false
DEVCON_SSH_PASSWORD=

# --- docker (rootless podman) ---
# Rootless docker/podman inside the container. When true, a rootless podman API
# socket runs and DOCKER_HOST points at it (so `docker compose` and the VS Code
# Docker extension work). The seccomp/apparmor/fuse settings in
# docker-compose.yml are required for this to function.
DEVCON_DOCKER=true
